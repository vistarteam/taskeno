# ---------------------------------------------------------------------------
# Taskeno environment contract.
# Copy to `.env` and fill in. The backend validates every key at boot and
# fails fast when a critical value is missing or malformed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
# Comma separated list of allowed browser origins (used when the API is exposed
# directly; in the default BFF setup the browser only ever talks to the website).
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL empty in development to use the embedded PGlite database.
# Set it to a real PostgreSQL URL in staging/production.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# --- Sessions / auth -------------------------------------------------------
SESSION_COOKIE_NAME=tk_session
SESSION_TTL_DAYS=30
SESSION_IDLE_TTL_HOURS=720
COOKIE_SECURE=false

# --- Money -----------------------------------------------------------------
CURRENCY=IRR
# Default global commission in basis points (1000 = 10%).
COMMISSION_DEFAULT_BPS=1000

# --- Order rules -----------------------------------------------------------
ORDER_ACCEPT_DEADLINE_HOURS=48
ORDER_AUTO_COMPLETE_DAYS=7
PAYMENT_EXPIRY_MINUTES=15

# --- Storage ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/uploads
UPLOAD_MAX_BYTES=2097152
UPLOAD_MAX_PER_SERVICE=12

# --- Payments --------------------------------------------------------------
# sandbox | zarinpal
PAYMENT_PROVIDER=sandbox
ZARINPAL_MERCHANT_ID=

# --- Feature flags ---------------------------------------------------------
# Transfers between users are legally sensitive: keep disabled in production
# until the compliance work in the plan is done.
FEATURE_P2P_TRANSFERS=true
FEATURE_WITHDRAWALS=false
FEATURE_SMS=false

# --- Jobs / worker ---------------------------------------------------------
JOBS_POLL_INTERVAL_MS=2000
JOBS_BATCH_SIZE=10

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
