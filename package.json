{
  "name": "taskeno",
  "version": "0.1.0",
  "private": true,
  "description": "Taskeno — digital services marketplace and internal economy platform",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:api": "pnpm --filter @taskeno/backend dev",
    "dev:worker": "pnpm --filter @taskeno/backend dev:worker",
    "dev:web": "pnpm --filter @taskeno/website dev",
    "db:generate": "pnpm --filter @taskeno/backend db:generate",
    "db:migrate": "pnpm --filter @taskeno/backend db:migrate",
    "db:seed": "pnpm --filter @taskeno/backend db:seed",
    "db:reset": "pnpm --filter @taskeno/backend db:reset",
    "commit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quick-commit.ps1"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.11"
  }
}
