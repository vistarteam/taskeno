# The registry can be slow; large WASM tarballs (PGlite) need generous timeouts.
fetch-timeout=900000
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
network-concurrency=4
strict-peer-dependencies=false
auto-install-peers=true
# Do not re-run `pnpm install` before every script: in this workspace the
# explicit `pnpm install` step is the single source of truth.
verify-deps-before-run=false
